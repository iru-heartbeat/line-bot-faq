# LINE Developers コンソールの「Messaging API設定」で取得できます
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# FAQで回答できない質問が来た時に通知を送る、オーナー様個人のLINEユーザーID
# (オーナー様がbotと1:1で友だち追加した状態で、Webhookのsource.userIdから確認できます)
LINE_OWNER_USER_ID=

# Supabase プロジェクトの Settings > API で取得できます
# SUPABASE_SERVICE_ROLE_KEY はサーバー側(Webhook)専用。ブラウザに絶対に渡さないこと
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console (console.anthropic.com) で取得できます
ANTHROPIC_API_KEY=

# 管理画面(/admin)のログインパスワード。オーナー様が自由に決めてよい
ADMIN_PASSWORD=
